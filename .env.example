# Local environment variables of the cbl-reporting service.
HTTP_ADDR=:8110
GRPC_ADDR=:9110
METRICS_ADDR=:9310
CLICKHOUSE_DSN=clickhouse://cbl:cbl@localhost:9000/reporting
# Brokers are resolved inside the ClickHouse container: when running the binary
# on top of the compose infrastructure, use the internal network address (kafka:29092).
KAFKA_BROKERS=kafka:29092
# Path of the wire schema relative to the ClickHouse server format_schema_path
# (the Kafka engine forbids an absolute path).
SCHEMA_PATH=events.proto
# Migrations directory; /app/migrations in the image.
MIGRATIONS_DIR=./migrations
# Ledger for the dim_accounts vocabulary and the check (required; cf-3.2 signature).
# On the service stand the test stub fits: after `make up` its gRPC listens on
# 127.0.0.1:9040 (inside the stand network - ledger-stub:9040).
LEDGER_GRPC_ADDR=localhost:9040
# Synchronization settings (default values are shown for completeness).
LEDGER_TIMEOUT=5s
DIM_REFRESH_INTERVAL=5m
DIM_MERCHANTS_LIMIT=200
BACKFILL_LIMIT=1000
LEDGER_CHECK_INTERVAL=5m
LEDGER_CHECK_WINDOW=5m
LEDGER_CHECK_ACCOUNTS=10
LEDGER_CHECK_PAGE_LIMIT=1000
LEDGER_CHECK_MAX_PAGES=10
