# Local environment variables for cbl-reporting.
HTTP_ADDR=:8110
GRPC_ADDR=:9110
METRICS_ADDR=:9310
CLICKHOUSE_DSN=clickhouse://cbl:cbl@localhost:9000/reporting
# Брокеры резолвятся внутри контейнера ClickHouse: при запуске бинарника
# поверх compose-инфраструктуры используйте внутренний адрес сети (kafka:29092).
KAFKA_BROKERS=kafka:29092
# Путь wire-схемы относительно format_schema_path сервера ClickHouse
# (абсолютный путь Kafka engine запрещает).
SCHEMA_PATH=events.proto
# Каталог миграций; в образе - /app/migrations.
MIGRATIONS_DIR=./migrations
# Ledger для словаря dim_accounts и сверки (обязателен; сигнатура cf-3.2).
# На сервисном стенде подходит тестовый stub: после `make up` его gRPC слушает
# 127.0.0.1:9040 (внутри сети стенда - ledger-stub:9040).
LEDGER_GRPC_ADDR=localhost:9040
# Настройки синхронизации (значения по умолчанию показаны для полноты).
LEDGER_TIMEOUT=5s
DIM_REFRESH_INTERVAL=5m
DIM_MERCHANTS_LIMIT=200
BACKFILL_LIMIT=1000
LEDGER_CHECK_INTERVAL=5m
LEDGER_CHECK_WINDOW=5m
LEDGER_CHECK_ACCOUNTS=10
LEDGER_CHECK_PAGE_LIMIT=1000
LEDGER_CHECK_MAX_PAGES=10
