# Local environment variables for cbl-reporting.
HTTP_ADDR=:8110
GRPC_ADDR=:9110
METRICS_ADDR=:9310
CLICKHOUSE_DSN=clickhouse://cbl:cbl@localhost:9000/reporting
# Брокеры резолвятся внутри контейнера ClickHouse: при запуске бинарника
# поверх compose-инфраструктуры используйте внутренний адрес сети (kafka:29092).
KAFKA_BROKERS=kafka:29092
# Путь wire-схемы относительно format_schema_path сервера ClickHouse
# (абсолютный путь Kafka engine запрещает).
SCHEMA_PATH=events.proto
# Каталог миграций; в образе - /app/migrations.
MIGRATIONS_DIR=./migrations
